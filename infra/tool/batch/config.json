{
  "base": "main",
  "branch_prefix": "batch/",
  "docs_root": "",
  "scope": {
    "ignore": [
      "dist/**",
      ".batch/**"
    ],
    "generated": [
      "dist/**"
    ]
  },
  "checks": [
    {
      "name": "commit-body",
      "command": [
        "python",
        "infra/checks/check_commit_body.py"
      ],
      "cwd": "."
    },
    {
      "name": "language",
      "command": [
        "python",
        ".agents/skills/nebula-bootstrap/scripts/check_language.py",
        "--root",
        "."
      ],
      "cwd": "."
    }
  ],
  "translate": [
    "python",
    "infra/tool/merge/translate_body.py",
    "--body",
    "{body}",
    "--locale",
    "{locale}",
    "--out",
    "{out}"
  ],
  "pr_create": [],
  "merge": []
}
